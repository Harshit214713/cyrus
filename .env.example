# Copy this file to .env (same folder) and fill in real values, then restart the dev server.
# Client ids are public identifiers - safe to store here. NEVER put an OAuth
# client SECRET in this file (or anywhere in this repo); for GitHub the secret
# belongs only in the exchange relay (scripts/github-exchange.worker.mjs).

# ── Google ───────────────────────────────────────────────────────────────────
# Google OAuth 2.0 Web client id (Google Cloud Console → Credentials).
# Enables the real "Google" popup in the sign-in sheet and dashboard.
# Console setup: OAuth client (Web) → Authorized JavaScript origins:
#   http://localhost:5330 (and your production origin).
# Leave empty to keep the demo sign-in flow.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# ── GitHub ───────────────────────────────────────────────────────────────────
# GitHub OAuth app client id (github.com → Settings → Developer settings →
# OAuth Apps → New OAuth App). Homepage URL: http://localhost:5330
# Authorization callback URL: http://localhost:5330/github-callback.html
# (add your production origin's callback too when you host the site).
# Enables the real "GitHub" popup sign-in (PKCE). Leave empty for the demo flow.
NEXT_PUBLIC_GITHUB_CLIENT_ID=

# Optional but recommended: URL of the token-exchange relay.
# github.com/login/oauth/access_token sends no CORS headers, so a static site
# cannot finish the exchange in the browser alone. Deploy
# scripts/github-exchange.worker.mjs (Cloudflare Worker, holds the client
# secret as a wrangler secret) and point this at its /exchange URL:
#   e.g. https://cyrus-gh-exchange.<account>.workers.dev/exchange
NEXT_PUBLIC_GITHUB_EXCHANGE_URL=

# ── Server (Next.js API + Neon Postgres) ─────────────────────────────────────
# Neon connection string (Neon console → Dashboard → Connection string,
# pooled). Everything degrades gracefully without it: API routes return 503
# and the frontend keeps using localStorage.
# After filling it in, run:  npm run db:push && npm run db:seed
DATABASE_URL=

# 32+ random chars used to sign the session cookie AND, when DATABASE_URL is
# absent, the email-code envelope that travels between /start and /verify.
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# On Vercel set this in Project Settings → Environment Variables (never commit).
SESSION_SECRET=

# GitHub OAuth app CLIENT SECRET. Local dev only (used by /api/auth/github).
# On Vercel set it as a secret. NEVER let this reach the browser bundle.
GITHUB_CLIENT_SECRET=

# ── Email sign-in (Resend) ───────────────────────────────────────────────────
# Resend API key (re_...) for sending the six-digit sign-in codes.
# Without a key /api/auth/email/* runs in demo mode and shows the code in the UI.
# A key from a Resend account with no verified sending domain returns 422 for
# every address except the account owner's, so codes never reach real users -
# verify a domain in Resend (DNS records required) before relying on email auth.
RESEND_API_KEY=

# Sender on a domain you verified in Resend, for example:
#   EMAIL_FROM="cyrus.ai <no-reply@mail.yourdomain.com>"
# Required in production: unset, sends are refused with a clear reason and
# /api/health reports email as "unverified_from". Outside production an unset
# value falls back to Resend's testing sender onboarding@resend.dev, which only
# delivers to the Resend account owner.
EMAIL_FROM=

# ── Cloudflare Turnstile (sign-in bot check) ─────────────────────────────────
# Gates POST /api/auth/email/start, i.e. every "send me a code" and every
# resend. Both values come from Cloudflare dashboard → Turnstile → Add a new
# widget → type "Managed", with your origin (localhost plus your production
# host) in the hostname list.
#
# Both empty or only one filled  -> the check is dormant: no widget renders, no
#                                  Cloudflare script loads, sign-in behaves
#                                  exactly as before.
# Both filled                    -> the check is strict and fails closed: a
#                                  request without a valid fresh token is
#                                  rejected, so a Cloudflare outage blocks code
#                                  sending rather than silently skipping it.
#
# Site key looks like 0x4AAAA...  (public, ships in the client bundle)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Secret key looks like 0x4AAAA... too, but it is server-only. Never expose it
# through a NEXT_PUBLIC_ name and never commit it.
TURNSTILE_SECRET_KEY=
